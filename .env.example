# ---------------------------------------------------------------------------
# Volatix environment configuration (example)
# Copy to `.env.local` and adjust as needed. Do not commit real secrets.
# ---------------------------------------------------------------------------

# Market data source mode.
#   mock → deterministic simulated data (default; dev/demo and explicit opt-in)
#   live → real market data via the configured provider (wired in Milestone 2+)
# Introduced in Milestone 1 as scaffolding; no runtime effect until later milestones.
MARKET_DATA_MODE=mock